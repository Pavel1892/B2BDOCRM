# Povinné v ostrém provozu: náhodný řetězec aspoň 16 znaků (podepisuje přihlášení)
SESSION_SECRET=

# Kam se ukládají data (na Railway cesta k připojenému volume, např. /data)
DATA_DIR=/data

# Nepovinné: kód, bez kterého nejde založit první účet Vedení
# SETUP_TOKEN=

# Nepovinné: ranní kontrola úhrad v ABRA Flexi (účet jen pro čtení)
# ABRA_URL=https://vase-firma.flexibee.eu
# ABRA_COMPANY=identifikator_firmy
# ABRA_USER=
# ABRA_PASSWORD=
# ABRA_SYNC_HOUR=6

# PORT nastavuje hosting sám
